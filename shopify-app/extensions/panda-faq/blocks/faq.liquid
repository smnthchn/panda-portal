{% comment %}
  Panda FAQ: the store FAQ page, layout B (section list on the left, every
  question on one page). Content comes from the faq_section / faq_question
  metaobjects that the Panda Portal edits; see docs/faq-plan.md in the portal.

  - Draft questions never reach Liquid; trashed ones are Draft too, and the
    trashed flag is checked as a guard.
  - Hidden or trashed sections are skipped, and so is any section with no
    Live question in it.
  - Each question keeps the old FAQ app's anchor (id="hc-<handle>"), so old
    links that jump to a question still land on it.
{% endcomment %}
{%- liquid
  assign accent = block.settings.accent_color
  assign button_color = block.settings.button_color
  assign contact_url = block.settings.contact_url | default: '/pages/contact-us'
  assign sections = shop.metaobjects.faq_section.values | sort: 'sort_order'
  assign total = 0
  assign first_entry = true
-%}

{%- paginate shop.metaobjects.faq_question.values by 250 -%}
  {%- assign questions = shop.metaobjects.faq_question.values | sort: 'sort_order' -%}

  {%- capture nav_items -%}{%- endcapture -%}
  {%- capture jump_options -%}{%- endcapture -%}
  {%- capture section_blocks -%}{%- endcapture -%}
  {%- capture jsonld_entries -%}{%- endcapture -%}

  {%- for s in sections -%}
    {%- if s.hidden == true or s.trashed == true -%}{%- continue -%}{%- endif -%}

    {%- assign count = 0 -%}
    {%- capture items -%}
      {%- for q in questions -%}
        {%- comment -%} An if, not continue: continue inside a capture isn't reliable. {%- endcomment -%}
        {%- if q.section.value.system.handle == s.system.handle and q.trashed != true -%}
        {%- assign count = count | plus: 1 -%}
        <details class="pfaq-q" id="hc-{{ q.system.handle }}" data-pfaq-q>
          <summary class="pfaq-summary">
            <h3 class="pfaq-question">{{ q.question | escape }}</h3>
            <svg class="pfaq-chevron" aria-hidden="true" focusable="false" width="14" height="8" viewBox="0 0 14 8" fill="none"><path d="M1 1L7 7L13 1" stroke="currentColor" stroke-width="2"/></svg>
          </summary>
          <div class="pfaq-answer">{{ q.answer | metafield_tag }}</div>
        </details>
        {%- capture entry -%}
          {"@type":"Question","name":{{ q.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ q.answer | metafield_tag | strip_html | strip | json }}}}
        {%- endcapture -%}
        {%- capture jsonld_entries -%}{{ jsonld_entries }}{% unless first_entry %},{% endunless %}{{ entry }}{%- endcapture -%}
        {%- assign first_entry = false -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if count == 0 -%}{%- continue -%}{%- endif -%}
    {%- assign total = total | plus: count -%}

    {%- capture nav_items -%}{{ nav_items }}<li><a href="#faq-{{ s.system.handle }}" data-pfaq-nav="faq-{{ s.system.handle }}"><span>{{ s.name | escape }}</span> <span class="pfaq-count">{{ count }}</span></a></li>{%- endcapture -%}
    {%- capture jump_options -%}{{ jump_options }}<option value="faq-{{ s.system.handle }}">{{ s.name | escape }}</option>{%- endcapture -%}
    {%- capture section_blocks -%}
      {{ section_blocks }}
      <section class="pfaq-sec" id="faq-{{ s.system.handle }}" aria-labelledby="faq-{{ s.system.handle }}-title" data-pfaq-sec>
        <h2 class="pfaq-sec-title" id="faq-{{ s.system.handle }}-title">{{ s.name | escape }}</h2>
        {{ items }}
      </section>
    {%- endcapture -%}
  {%- endfor -%}
{%- endpaginate -%}

<div class="pfaq" style="--pfaq-accent: {{ accent }}; --pfaq-button: {{ button_color }};" data-pfaq>
  {%- if block.settings.heading != blank -%}
    <h1 class="pfaq-title">{{ block.settings.heading | escape }}</h1>
  {%- endif -%}

  {%- if total == 0 -%}
    <p class="pfaq-empty">There are no questions here yet.</p>
  {%- else -%}
    {%- if block.settings.show_search -%}
      <div class="pfaq-search">
        <input type="search" placeholder="Search" aria-label="Search the FAQ" data-pfaq-search>
        <p class="pfaq-results" data-pfaq-results hidden></p>
      </div>
    {%- endif -%}

    <div class="pfaq-cols">
      <nav class="pfaq-side" aria-label="FAQ sections">
        <p class="pfaq-side-label">Sections</p>
        <ul>{{ nav_items }}</ul>
      </nav>

      <select class="pfaq-jump" aria-label="Jump to a section" data-pfaq-jump>
        <option value="">Jump to a section</option>
        {{ jump_options }}
      </select>

      <div class="pfaq-main">
        {{ section_blocks }}
        <div class="pfaq-none" data-pfaq-none hidden>{{ block.settings.no_results_text }}</div>
      </div>
    </div>
  {%- endif -%}

  {%- if block.settings.contact_heading != blank or block.settings.contact_text != blank -%}
    <div class="pfaq-contact">
      {%- if block.settings.contact_heading != blank -%}<h2>{{ block.settings.contact_heading | escape }}</h2>{%- endif -%}
      {{ block.settings.contact_text }}
      {%- if block.settings.contact_button_label != blank -%}
        <a class="pfaq-button" href="{{ contact_url }}">{{ block.settings.contact_button_label | escape }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{%- if total > 0 -%}
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ jsonld_entries }}]}</script>
{%- endif -%}

{% schema %}
{
  "name": "Panda FAQ",
  "target": "section",
  "stylesheet": "faq.css",
  "javascript": "faq.js",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Page title",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search box",
      "default": true
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour (open question, section list)",
      "default": "#f04f36"
    },
    {
      "type": "richtext",
      "id": "no_results_text",
      "label": "When a search finds nothing",
      "default": "<p><strong>No answers match that.</strong> Try a shorter word, or email customerservice@pandahobby.ca and we'll help.</p>"
    },
    {
      "type": "header",
      "content": "Contact box"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Heading",
      "default": "Still have a question?"
    },
    {
      "type": "richtext",
      "id": "contact_text",
      "label": "Text",
      "default": "<p>Email <strong>customerservice@pandahobby.ca</strong> or use our contact form. We answer Monday to Friday, 12pm to 5pm.</p>"
    },
    {
      "type": "text",
      "id": "contact_button_label",
      "label": "Button label",
      "default": "Contact us"
    },
    {
      "type": "text",
      "id": "contact_url",
      "label": "Button link",
      "default": "/pages/contact-us"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button colour",
      "default": "#8cc63e"
    }
  ]
}
{% endschema %}
